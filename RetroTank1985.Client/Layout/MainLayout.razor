@inherits LayoutComponentBase

<MudThemeProvider Theme="_retroTheme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Dense="false" Class="px-3 px-md-6" Style="background-color: #11141c; border-bottom: 2px solid #232938;">
        <!-- Mobile Drawer Toggle Button -->
        <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                       Color="Color.Warning" 
                       Edge="Edge.Start" 
                       OnClick="ToggleNavDrawer" 
                       Class="d-inline-flex d-md-none mr-2" 
                       aria-label="Open Navigation Menu" />

        <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Warning" Size="Size.Medium" Class="mr-2 mr-md-3" />
        <MudText Typo="Typo.h6" Class="pixel-text" Style="color: #f1c40f; font-size: 0.95rem; white-space: nowrap;">
            RETRO TANK 1985
        </MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="ml-3 pixel-text d-none d-lg-inline-flex" Style="font-size: 0.65rem;">
            NES REMAKE WASM
        </MudChip>
        
        <MudSpacer />

        <!-- Desktop Navigation Items (Hidden on Mobile/Tablet) -->
        <div class="d-none d-md-flex align-center gap-1">
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/" StartIcon="@Icons.Material.Filled.Home">
                Home
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Warning" Href="arcade" StartIcon="@Icons.Material.Filled.VideogameAsset">
                Arcade (1P)
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Success" Href="coop" StartIcon="@Icons.Material.Filled.Groups">
                Online Co-Op (2P)
            </MudButton>

            <!-- Dev Tools Dropdown Menu -->
            <MudMenu Label="Dev Tools" Color="Color.Error" StartIcon="@Icons.Material.Filled.Build" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Dense="true">
                <MudMenuItem Href="dev" Icon="@Icons.Material.Filled.Dashboard">Dev Portal</MudMenuItem>
                <MudMenuItem Href="sandbox" Icon="@Icons.Material.Filled.Terminal">Engine Sandbox</MudMenuItem>
                <MudMenuItem Href="sound-bgm" Icon="@Icons.Material.Filled.GraphicEq">Sound APU Synth</MudMenuItem>
                <MudMenuItem Href="stage-inspector" Icon="@Icons.Material.Filled.Map">Stage Inspector</MudMenuItem>
            </MudMenu>
        </div>

        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://github.com/Nitkz/RetroTank1985" Target="_blank" Class="ml-1 ml-md-2" />
    </MudAppBar>

    <!-- Mobile Navigation Drawer -->
    <MudDrawer @bind-Open="_navDrawerOpen" ClipMode="DrawerClipMode.Always" Elevation="4" Variant="DrawerVariant.Temporary" Class="d-md-none" Style="background-color: #11141c; border-right: 2px solid #232938;">
        <div class="pa-4 d-flex align-center gap-2" style="border-bottom: 1px solid #232938;">
            <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Warning" />
            <span class="pixel-text font-bold" style="color: #f1c40f; font-size: 0.85rem;">RETRO TANK 1985</span>
        </div>
        <MudNavMenu Class="pa-2">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" OnClick="CloseNavDrawer">
                Home Hub
            </MudNavLink>
            <MudNavLink Href="arcade" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VideogameAsset" IconColor="Color.Warning" OnClick="CloseNavDrawer">
                Arcade Mode (1P)
            </MudNavLink>
            <MudNavLink Href="coop" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Groups" IconColor="Color.Success" OnClick="CloseNavDrawer">
                Online Co-Op (2P)
            </MudNavLink>
            
            <MudDivider Class="my-2" Style="background: #232938;" />
            <MudNavGroup Title="Dev Tools" Icon="@Icons.Material.Filled.Build" IconColor="Color.Error" Expanded="true">
                <MudNavLink Href="dev" Icon="@Icons.Material.Filled.Dashboard" OnClick="CloseNavDrawer">
                    Dev Portal
                </MudNavLink>
                <MudNavLink Href="sandbox" Icon="@Icons.Material.Filled.Terminal" OnClick="CloseNavDrawer">
                    Engine Sandbox
                </MudNavLink>
                <MudNavLink Href="sound-bgm" Icon="@Icons.Material.Filled.GraphicEq" OnClick="CloseNavDrawer">
                    Sound APU Synth
                </MudNavLink>
                <MudNavLink Href="stage-inspector" Icon="@Icons.Material.Filled.Map" OnClick="CloseNavDrawer">
                    Stage Inspector
                </MudNavLink>
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pt-16">
        <article class="retro-container pt-8">
            @Body
        </article>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _navDrawerOpen = false;

    private void ToggleNavDrawer()
    {
        _navDrawerOpen = !_navDrawerOpen;
    }

    private void CloseNavDrawer()
    {
        _navDrawerOpen = false;
    }

    private MudTheme _retroTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#f1c40f",
            Secondary = "#2ecc71",
            Tertiary = "#e74c3c",
            Background = "#0c0d12",
            Surface = "#161a23",
            AppbarBackground = "#11141c",
            DrawerBackground = "#11141c",
            TextPrimary = "#f8fafc",
            TextSecondary = "#94a3b8",
            ActionDefault = "#f1c40f"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Rajdhani", "sans-serif" }
            }
        }
    };
}
