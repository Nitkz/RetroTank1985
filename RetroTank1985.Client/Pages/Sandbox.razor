@page "/sandbox"
@page "/dev/sandbox"
@page "/play"
@using RetroTank1985.Client.Components.Sandbox
@using RetroTank1985.Client.Components.Controls

<PageTitle>RetroTank 1985 | Engine Sandbox &amp; Physics Lab</PageTitle>

<!-- Header Title -->
<div class="mb-3 d-flex align-center gap-2">
    <MudText Typo="Typo.h5" Class="pixel-text" Style="color: #ef4444; text-shadow: 0 0 12px rgba(239, 68, 68, 0.4);">
        ENGINE SANDBOX &amp; PHYSICS LAB
    </MudText>
    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.65rem;">
        DEV LAB &bull; CHEAT SUITE
    </MudChip>
    <span class="pixel-text ml-2 d-none d-md-inline" style="color: #64748b; font-size: 0.6rem;">
        CHEAT TOOLS &bull; TELEMETRY HUD &bull; VIRTUAL D-PAD &bull; NES APU
    </span>
</div>

<!-- Full-Width Top Action & Stage Navigation Bar -->
<div class="mb-4 w-100">
    <GameControlBar SelectedStage="@_selectedStage"
                    IsMuted="@_isMuted"
                    IsTwoPlayer="@_isTwoPlayer"
                    HighScore="@_highScore"
                    StageChanged="OnStageSelected"
                    OnRestartStage="RestartStage"
                    OnToggleMute="ToggleMute"
                    OnToggleTwoPlayer="ToggleTwoPlayerMode" />
</div>

<MudGrid Spacing="3">
    <!-- Primary Arena Column (Screen + Telemetry + Immediate Mobile D-Pad Control) -->
    <MudItem xs="12" lg="7" Class="d-flex flex-column align-center">
        <!-- Telemetry HUD -->
        <div class="mb-2" style="width: 512px; max-width: 100%;">
            <TelemetryHud Telemetry="@_telemetry" />
        </div>

        <!-- Game Canvas Screen & Mobile Controller Container -->
        <div id="playBezelContainer" class="arcade-bezel mb-2" style="width: 512px; max-width: 100%; display: flex; flex-direction: column; align-items: center;">
            <canvas id="gameArenaCanvas" class="game-canvas" width="512" height="480"></canvas>

            <!-- MOBA-Style Virtual Touch Controller (Floating Dynamic Joystick + Action Cluster) -->
            <div class="w-100 mt-2">
                <MobaTouchController PlayerIndex="@(_isCoopSession ? (_isCoopHost ? 1 : 2) : 1)" ShowPlayerSwitch="@(!_isCoopSession)" />
            </div>
        </div>
    </MudItem>

    <!-- Sidebar Column (Recon Briefing & Sandbox Cheat Lab) -->
    <MudItem xs="12" lg="5">
        <!-- 1. Mission Briefing Card -->
        <MissionBriefingCard StageNumber="@_selectedStage" Stage="@_currentStage" />

        <!-- 2. Debug & Cheat Sandbox Drawer (Collapsible) -->
        <GameDebugSandboxPanel OnSpawnRequested="HandleDebugSpawn"
                               OnNukeRequested="HandleDebugNuke"
                               OnClearRequested="HandleDebugClear"
                               OnStarPowerRequested="HandleDebugStarPower"
                               OnShieldToggleRequested="HandleDebugShieldToggle"
                               OnResetPlayerRequested="ResetPlayer"
                               OnFortifyEagleRequested="HandleDebugFortifyEagle"
                               OnSpawnPowerUpRequested="HandleDebugSpawnPowerUp"
                               OnTriggerCurtainRequested="HandleDebugTriggerCurtain"
                               OnSimulateClearStageRequested="HandleDebugSimulateClearStage"
                               OnTriggerGameOverRequested="HandleDebugTriggerGameOver" />
    </MudItem>
</MudGrid>




