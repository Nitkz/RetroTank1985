@page "/play"

<PageTitle>RetroTank 1985 | Stage Arena</PageTitle>

<!-- Header Section -->
<div class="mb-4 d-flex flex-column flex-md-row justify-space-between align-start align-md-center gap-4">
    <div>
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.h4" Class="pixel-text" Style="color: #ef4444; text-shadow: 0 0 12px rgba(239, 68, 68, 0.4);">
                STAGE ARENA
            </MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.65rem;">
                C# HYBRID ENGINE
            </MudChip>
        </div>
        <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mt-1">
            .NET 9 C# Game Brain &bull; 60 FPS Canvas Muscle &bull; Sub-Tile Destructible Terrain &bull; APU Synth
        </MudText>
    </div>

    <!-- Top Action & Stage Control Bar -->
    <GameControlBar SelectedStage="@_selectedStage"
                    IsMuted="@_isMuted"
                    StageChanged="OnStageSelected"
                    OnReset="ResetPlayer"
                    OnToggleMute="ToggleMute" />
</div>

<MudGrid Spacing="3">
    <!-- Left: Main Game Screen Canvas & Live Telemetry -->
    <MudItem xs="12" lg="7" Class="d-flex flex-column align-center justify-center">
        <div class="arcade-bezel">
            <canvas id="gameArenaCanvas" class="game-canvas" width="480" height="480"></canvas>
        </div>

        <TelemetryHud Telemetry="@_telemetry" />
    </MudItem>

    <!-- Right: Mission Briefing & Virtual Controller -->
    <MudItem xs="12" lg="5">
        <MissionBriefingCard StageNumber="@_selectedStage" Stage="@_currentStage" />

        <VirtualDPad />
    </MudItem>
</MudGrid>
