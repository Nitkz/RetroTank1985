@page "/arcade"
@using RetroTank1985.Client.Components.Arcade
@using RetroTank1985.Client.Components.Controls
@using RetroTank1985.Client.Components.Coop

<PageTitle>RetroTank 1985 | @(_isCoopSession ? "Online Co-Op Mode (2-Player)" : "Arcade Mode (1P Campaign)")</PageTitle>

<div class="d-flex flex-column align-center w-100 mb-6">
    <!-- 1. Top Arcade Marquee & Status Header -->
    <ArcadeHeader IsCoopSession="@_isCoopSession"
                  IsCoopHost="@_isCoopHost"
                  RoomCode="@_roomCode"
                  HighScore="@_highScore"
                  Telemetry="@_telemetry"
                  Settings="@_settings" />

    <!-- 2. Arcade Control Bar (Stage Indicator, Exit, Sound, Fullscreen, Emotes) -->
    <ArcadeControlBar IsCoopSession="@_isCoopSession"
                      SelectedStage="@_selectedStage"
                      IsMuted="@_isMuted"
                      OnExit="HandleExitAsync"
                      OnToggleEmote="ToggleEmoteWheel"
                      OnToggleMute="ToggleMute"
                      OnToggleFullscreen="ToggleFullscreen" />

    <!-- 3. Arcade Screen Container (Houses Canvas + Overlays + MOBA Touch Controller) -->
    <div id="arcadeBezelContainer" class="arcade-bezel mb-3" style="position: relative; width: 536px; max-width: 100%; display: flex; flex-direction: column; align-items: stretch;">
        <canvas id="arcadeGameCanvas" class="game-canvas" width="512" height="480"></canvas>

        <!-- Disconnection Grace Period Overlay (15s Reconnect Flow) -->
        <ArcadeDisconnectOverlay IsActive="@_isDisconnectGraceActive"
                                 IsCoopHost="@_isCoopHost"
                                 SecondsRemaining="@_disconnectGraceSeconds"
                                 OnContinueSolo="HandleConvertToSinglePlayer"
                                 OnAbortMission="HandleLeaveSession" />

        <!-- Retro Arcade Game Over Modal Overlay -->
        <ArcadeGameOverOverlay IsVisible="@_isGameOverOverlayVisible"
                               IsCoopSession="@_isCoopSession"
                               IsCoopHost="@_isCoopHost"
                               Reason="@(GetGameOverReason())"
                               Telemetry="@_telemetry"
                               HighScore="@_highScore"
                               OnRetry="@(_isCoopSession ? HandleCoopRetryStage : RestartStage)"
                               OnRestartStage1="HandleRestartFromStage1"
                               OnReturnToLobby="HandleReturnToLobby"
                               OnReturnToMenu="HandleReturnToMenu"
                               OnLeave="HandleLeaveSession" />
        
        <!-- MOBA-Style Virtual Touch Controller (Inline on normal view, Overlay on Fullscreen) -->
        <div class="w-100 mt-2" style="padding: 0;">
            <MobaTouchController PlayerIndex="@(_isCoopSession ? (_isCoopHost ? 1 : 2) : 1)" 
                                ShowPlayerSwitch="false" 
                                ShowEmote="@_isCoopSession" />
        </div>
    </div>

    <!-- 4. Tactical Emote Wheel Modal (Only in Co-Op Session) -->
    @if (_isCoopSession)
    {
        <EmoteWheel @bind-IsOpen="_isEmoteWheelOpen" OnEmoteSelected="HandleEmoteSelected" />
    }

    <!-- 5. Keyboard-Only Instructions & Legend Badge (Desktop hint) -->
    <ArcadeControlsLegend IsCoopSession="@_isCoopSession" />
</div>
