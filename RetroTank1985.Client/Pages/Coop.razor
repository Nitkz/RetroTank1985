@page "/coop"
@rendermode InteractiveWebAssembly

<PageTitle>RetroTank 1985 | Online 2-Player Co-Op Lobby</PageTitle>

<div class="retro-container py-6">
    <!-- Header -->
    <div class="mb-6 text-center">
        <div class="d-flex align-center justify-center gap-2 mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Public" Color="Color.Success" Size="Size.Large" />
            <MudText Typo="Typo.h4" Class="pixel-text font-bold" Style="color: #2ecc71; text-shadow: 0 0 16px rgba(46, 204, 113, 0.4);">
                ONLINE 2-PLAYER CO-OP
            </MudText>
        </div>
        <MudText Typo="Typo.subtitle1" Style="color: #94a3b8; letter-spacing: 1px;">
            REAL-TIME P2P MULTIPLAYER LOBBY (STAGE 01–35)
        </MudText>
    </div>

    @if (LobbyService.CurrentRoom == null)
    {
        <!-- Form: Create or Join Room -->
        <div style="max-width: 960px; margin: 0 auto;">
            <!-- Player Name Settings Card -->
            <MudCard Elevation="4" Class="retro-card pa-4 mb-5" Style="background: linear-gradient(90deg, #131926 0%, #161a26 100%); border: 1px solid #334155;">
                <div class="d-flex align-center gap-3 flex-wrap">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Warning" Size="Size.Large" />
                        <div>
                            <span class="pixel-text" style="color: #f1c40f; font-size: 0.75rem; font-weight: bold; display: block;">PLAYER IDENTITY</span>
                            <span style="font-size: 0.7rem; color: #94a3b8;">Callsign for online matchmaking</span>
                        </div>
                    </div>
                    <div style="flex: 1; min-width: 240px;">
                        <MudTextField @bind-Value="PlayerName" 
                                      Label="CALLSIGN (NAME)" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      MaxLength="15" 
                                      HelperText="ชื่อที่จะแสดงในห้องเล่นเกม (ความยาวไม่เกิน 15 ตัวอักษร)" 
                                      Adornment="Adornment.End" 
                                      AdornmentIcon="@Icons.Material.Filled.Badge" 
                                      AdornmentColor="Color.Warning" 
                                      Style="font-family: var(--retro-font); font-size: 0.8rem;" />
                    </div>
                </div>
            </MudCard>

            <MudGrid Spacing="4">
                <!-- Card 1: Create New Room (Host P1) -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="6" Class="retro-card pa-5 h-100 d-flex flex-column justify-space-between" Style="background: linear-gradient(145deg, #1e2417 0%, #11141c 100%); border: 2px solid #f1c40f;">
                        <div>
                            <div class="d-flex align-center justify-space-between mb-3">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Warning" Size="Size.Large" />
                                    <div>
                                        <MudText Typo="Typo.h6" Class="pixel-text font-bold" Style="color: #f1c40f; font-size: 1.05rem;">
                                            HOST ROOM
                                        </MudText>
                                        <span style="font-size: 0.7rem; color: #94a3b8;">Create session &bull; Lead mission</span>
                                    </div>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.65rem;">
                                    1P YELLOW
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #cbd5e1; line-height: 1.6; min-height: 52px;" Class="mb-4">
                                สร้างห้องใหม่เพื่อเป็นหัวหน้าทีม (Host P1) กำหนดเลือกด่าน Stage 01–35 ปรับออปชันเกม และแชร์รหัสห้อง/QR Code ให้เพื่อนเข้าร่วม
                            </MudText>

                            <div class="pa-3 mb-4" style="background: rgba(0, 0, 0, 0.4); border: 1px solid #2d3748; border-radius: 8px;">
                                <MudSelect T="int" @bind-Value="SelectedInitialStage" Label="Starting Stage" Margin="Margin.Dense" Variant="Variant.Outlined" Style="font-family: var(--retro-font); font-size: 0.75rem;">
                                    @for (int i = 1; i <= 35; i++)
                                    {
                                        var stageNum = i;
                                        <MudSelectItem T="int" Value="@stageNum">STAGE @stageNum.ToString("D2")</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        </div>

                        <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" Class="pixel-text py-3" Style="font-size: 0.85rem;" Disabled="@IsLoading" OnClick="HandleCreateRoom">
                            @if (IsLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>CREATING...</span>
                            }
                            else
                            {
                                <span>CREATE ROOM (HOST)</span>
                            }
                        </MudButton>
                    </MudCard>
                </MudItem>

                <!-- Card 2: Join Existing Room (Guest P2) -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="6" Class="retro-card pa-5 h-100 d-flex flex-column justify-space-between" Style="background: linear-gradient(145deg, #13241d 0%, #11141c 100%); border: 2px solid #2ecc71;">
                        <div>
                            <div class="d-flex align-center justify-space-between mb-3">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Login" Color="Color.Success" Size="Size.Large" />
                                    <div>
                                        <MudText Typo="Typo.h6" Class="pixel-text font-bold" Style="color: #2ecc71; font-size: 1.05rem;">
                                            JOIN ROOM
                                        </MudText>
                                        <span style="font-size: 0.7rem; color: #94a3b8;">Join with code &bull; 2P Wingman</span>
                                    </div>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.65rem;">
                                    2P GREEN
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #cbd5e1; line-height: 1.6; min-height: 52px;" Class="mb-4">
                                ป้อนรหัสห้อง 6 หลักที่ได้รับจากเพื่อนเพื่อเข้าร่วมเป็น Player 2 (รถถังสีเขียว) ร่วมปกป้องฐานนกอินทรีและลุยเคียงบ่าเคียงไหล่
                            </MudText>

                            <div class="pa-3 mb-4" style="background: rgba(0, 0, 0, 0.4); border: 1px solid #2d3748; border-radius: 8px;">
                                <MudTextField @bind-Value="InputRoomCode" 
                                              Label="6-DIGIT ROOM CODE" 
                                              Placeholder="e.g. TANK85" 
                                              Variant="Variant.Outlined" 
                                              Margin="Margin.Dense" 
                                              Class="pixel-text" 
                                              MaxLength="6" 
                                              Style="text-transform: uppercase; font-family: var(--retro-font); font-size: 0.75rem;" 
                                              Adornment="Adornment.End" 
                                              AdornmentIcon="@Icons.Material.Filled.VpnKey" 
                                              AdornmentColor="Color.Success" />
                            </div>
                        </div>

                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="pixel-text py-3" Style="font-size: 0.85rem;" Disabled="@(IsLoading || string.IsNullOrWhiteSpace(InputRoomCode))" OnClick="HandleJoinRoom">
                            @if (IsLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>JOINING...</span>
                            }
                            else
                            {
                                <span>JOIN MISSION (GUEST)</span>
                            }
                        </MudButton>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </div>
    }
    else
    {
        <!-- In Lobby Room Screen -->
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="10" lg="8">
                <RetroTank1985.Client.Components.Coop.CoopLobbyCard Room="@LobbyService.CurrentRoom" 
                                                                     IsHost="@LobbyService.IsHost" 
                                                                     IsGuest="@LobbyService.IsGuest" 
                                                                     GameSettings="@_settings"
                                                                     OnOpenOptions="OpenOptionsDialog"
                                                                     OnCopyCode="CopyRoomCode" 
                                                                     OnShareInvite="ShareInviteLink" 
                                                                     OnShowQr="ShowQrDialog" 
                                                                     OnStageChanged="ChangeStage" 
                                                                     OnToggleReady="ToggleReady" 
                                                                     OnStartGame="StartGame" 
                                                                     OnResumeGame="ResumeGame" 
                                                                     OnLeaveRoom="LeaveRoom" />
            </MudItem>
        </MudGrid>
    }
</div>
