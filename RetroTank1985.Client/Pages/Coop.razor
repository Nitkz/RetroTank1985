@page "/coop"
@rendermode InteractiveWebAssembly

<PageTitle>RetroTank 1985 | Online 2-Player Co-Op Lobby</PageTitle>

<div class="retro-container py-6">
    <!-- Header -->
    <div class="mb-6 text-center">
        <div class="d-flex align-center justify-center gap-2 mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Public" Color="Color.Success" Size="Size.Large" />
            <MudText Typo="Typo.h4" Class="pixel-text font-bold" Style="color: #2ecc71; text-shadow: 0 0 16px rgba(46, 204, 113, 0.4);">
                ONLINE 2-PLAYER CO-OP
            </MudText>
        </div>
        <MudText Typo="Typo.subtitle1" Style="color: #94a3b8; letter-spacing: 1px;">
            REAL-TIME P2P MULTIPLAYER LOBBY (STAGE 01–35)
        </MudText>
    </div>

    @if (LobbyService.CurrentRoom == null)
    {
        <!-- Form: Create or Join Room -->
        <MudGrid Justify="Justify.Center" Spacing="4">
            <!-- Player Name Settings Card -->
            <MudItem xs="12" md="8">
                <MudCard Elevation="4" Class="retro-card pa-4 mb-4" Style="background: #161a26;">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Warning" Size="Size.Large" />
                        <div style="flex: 1;">
                            <MudTextField @bind-Value="PlayerName" Label="PLAYER CALLSIGN (NAME)" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="15" HelperText="ชื่อที่จะแสดงในห้องเล่นเกม (ความยาวไม่เกิน 15 ตัวอักษร)" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Badge" AdornmentColor="Color.Warning" />
                        </div>
                    </div>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <!-- Card 1: Create New Room (Host P1) -->
                <MudCard Elevation="6" Class="retro-card pa-5 h-100 d-flex flex-column justify-space-between" Style="background: linear-gradient(145deg, #1e2417 0%, #11141c 100%); border-color: #f1c40f;">
                    <div>
                        <div class="d-flex align-center justify-space-between mb-3">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Warning" Size="Size.Large" />
                                <MudText Typo="Typo.h6" Class="pixel-text font-bold" Style="color: #f1c40f; font-size: 1.05rem;">
                                    HOST ROOM
                                </MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.6rem;">
                                1P YELLOW
                            </MudChip>
                        </div>
                        <MudText Typo="Typo.body2" Style="color: #cbd5e1; line-height: 1.6;" Class="mb-4">
                            สร้างห้องใหม่เพื่อเป็นหัวหน้าทีม (Host P1) กำหนดเลือกด่าน Stage 01–35 และแชร์รหัสห้อง/QR Code ให้เพื่อนเข้าร่วม
                        </MudText>

                        <MudSelect T="int" @bind-Value="SelectedInitialStage" Label="Starting Stage" Margin="Margin.Dense" Variant="Variant.Outlined" Class="mb-4">
                            @for (int i = 1; i <= 35; i++)
                            {
                                var stageNum = i;
                                <MudSelectItem T="int" Value="@stageNum">Stage @stageNum.ToString("D2")</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" Class="pixel-text py-3" Style="font-size: 0.85rem;" Disabled="@IsLoading" OnClick="HandleCreateRoom">
                        @if (IsLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>CREATING...</span>
                        }
                        else
                        {
                            <span>CREATE ROOM (HOST)</span>
                        }
                    </MudButton>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <!-- Card 2: Join Existing Room (Guest P2) -->
                <MudCard Elevation="6" Class="retro-card pa-5 h-100 d-flex flex-column justify-space-between" Style="background: linear-gradient(145deg, #13241d 0%, #11141c 100%); border-color: #2ecc71;">
                    <div>
                        <div class="d-flex align-center justify-space-between mb-3">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Login" Color="Color.Success" Size="Size.Large" />
                                <MudText Typo="Typo.h6" Class="pixel-text font-bold" Style="color: #2ecc71; font-size: 1.05rem;">
                                    JOIN ROOM
                                </MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.6rem;">
                                2P GREEN
                            </MudChip>
                        </div>
                        <MudText Typo="Typo.body2" Style="color: #cbd5e1; line-height: 1.6;" Class="mb-4">
                            ป้อนรหัสห้อง 6 หลักที่ได้รับจากเพื่อนเพื่อเข้าร่วมเป็น Player 2 (รถถังสีเขียว) และร่วมลุยภารกิจ
                        </MudText>

                        <MudTextField @bind-Value="InputRoomCode" Label="6-DIGIT ROOM CODE" Placeholder="e.g. TANK85" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4 pixel-text" MaxLength="6" Style="text-transform: uppercase;" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.VpnKey" AdornmentColor="Color.Success" />
                    </div>

                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="pixel-text py-3" Style="font-size: 0.85rem;" Disabled="@(IsLoading || string.IsNullOrWhiteSpace(InputRoomCode))" OnClick="HandleJoinRoom">
                        @if (IsLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>JOINING...</span>
                        }
                        else
                        {
                            <span>JOIN MISSION (GUEST)</span>
                        }
                    </MudButton>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <!-- In Lobby Room Screen -->
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="10" lg="8">
                <RetroTank1985.Client.Components.Coop.CoopLobbyCard Room="@LobbyService.CurrentRoom" 
                                                                     IsHost="@LobbyService.IsHost" 
                                                                     IsGuest="@LobbyService.IsGuest" 
                                                                     GameSettings="@_settings"
                                                                     OnOpenOptions="OpenOptionsDialog"
                                                                     OnCopyCode="CopyRoomCode" 
                                                                     OnShareInvite="ShareInviteLink" 
                                                                     OnShowQr="ShowQrDialog" 
                                                                     OnStageChanged="ChangeStage" 
                                                                     OnToggleReady="ToggleReady" 
                                                                     OnStartGame="StartGame" 
                                                                     OnLeaveRoom="LeaveRoom" />
            </MudItem>
        </MudGrid>
    }
</div>
