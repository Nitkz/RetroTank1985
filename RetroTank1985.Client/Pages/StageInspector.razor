@page "/stage-inspector"
@inject StageService StageService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>RetroTank 1985 | Stage &amp; CHR Inspector</PageTitle>

<div class="mb-6">
    <div class="d-flex align-center justify-space-between flex-wrap gap-4">
        <div>
            <MudText Typo="Typo.h4" Class="pixel-text font-bold" Style="color: #f1c40f; text-shadow: 0 0 12px rgba(241, 196, 15, 0.4);">
                STAGE &amp; ROM INSPECTOR
            </MudText>
            <MudText Typo="Typo.subtitle1" Style="color: #94a3b8; font-family: 'Rajdhani', sans-serif; letter-spacing: 1px;">
                REVERSE-ENGINEERED 35 FAMICOM STAGES ($F07A) &amp; CHR-ROM TILEMAP ($DB79)
            </MudText>
        </div>
        <div class="d-flex align-center gap-3">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.7rem;">
                35 STAGES EXTRACTED
            </MudChip>
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.7rem;">
                NES PALETTE $D44A
            </MudChip>
        </div>
    </div>
</div>

<MudTabs Elevation="3" Rounded="true" ApplyEffectsToContainer="true" Class="retro-card"
         ActivePanelIndexChanged="OnActiveTabChanged">
    <!-- TAB 1: 35 STAGES VIEWER -->
    <MudTabPanel Text="STAGE ARENA VIEWER" Icon="@Icons.Material.Filled.Map">
        <MudGrid Spacing="4">
            <!-- Left Column: Controls & Canvas Display -->
            <MudItem xs="12" lg="7">
                <MudCard Elevation="2" Class="pa-4 retro-card">
                    <!-- Stage Switcher Controls -->
                    <div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-2">
                        <div class="d-flex align-center gap-2">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBackIos" Color="Color.Warning" Variant="Variant.Outlined" 
                                           OnClick="PrevStage" Disabled="@(_currentStageNum <= 1)" Size="Size.Small" />
                            <MudText Typo="Typo.h5" Class="pixel-text px-2" Style="color: #f1c40f; min-width: 140px; text-align: center;">
                                STAGE @(_currentStageNum.ToString("D2"))
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowForwardIos" Color="Color.Warning" Variant="Variant.Outlined" 
                                           OnClick="NextStage" Disabled="@(_currentStageNum >= 35)" Size="Size.Small" />
                        </div>

                        <!-- Display Options -->
                        <div class="d-flex align-center gap-3">
                            <MudCheckBox T="bool" Value="_showGrid" Color="Color.Warning" Dense="true" Label="Grid" 
                                         ValueChanged="OnGridOptionChanged" />
                            <MudCheckBox T="bool" Value="_showSpawns" Color="Color.Error" Dense="true" Label="Spawns" 
                                         ValueChanged="OnSpawnsOptionChanged" />
                            <MudCheckBox T="bool" Value="_showCoords" Color="Color.Info" Dense="true" Label="Coords" 
                                         ValueChanged="OnCoordsOptionChanged" />
                        </div>
                    </div>

                    <!-- Slider quick jump -->
                    <div class="mb-4 px-2">
                        <MudSlider T="int" Value="_currentStageNum" Min="1" Max="35" Step="1" Color="Color.Warning" 
                                   ValueChanged="OnSliderChanged" ValueLabel="true">
                            <span class="pixel-text" style="font-size: 0.65rem; color: #94a3b8;">SELECT STAGE (1 - 35)</span>
                        </MudSlider>
                    </div>

                    <!-- Canvas Stage Container -->
                    <div class="d-flex justify-center align-center pa-2" style="background: #090a0f; border-radius: 8px; border: 2px solid #232938; overflow-x: auto;">
                        <canvas id="stageCanvas" width="480" height="480" style="image-rendering: pixelated; border-radius: 4px; box-shadow: 0 0 20px rgba(0,0,0,0.8); width: 480px; height: 480px;"></canvas>
                    </div>
                </MudCard>
            </MudItem>

            <!-- Right Column: Stage Intel & Breakdown -->
            <MudItem xs="12" lg="5">
                <MudCard Elevation="2" Class="pa-4 retro-card mb-4">
                    <div class="d-flex align-center mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Warning" Class="mr-2" />
                        <MudText Typo="Typo.h6" Class="pixel-text" Style="color: #f1c40f; font-size: 0.9rem;">
                            ENEMY RECON ($E4EC / $E578)
                        </MudText>
                    </div>

                    @if (_currentStage != null)
                    {
                        <!-- Enemy count summary cards -->
                        <MudGrid Spacing="2" Class="mb-4">
                            <!-- Basic Tank -->
                            <MudItem xs="6" sm="3">
                                <div class="pa-2 text-center" style="background: #11141c; border-radius: 6px; border: 1px solid #334155;">
                                    <div class="pixel-text" style="font-size: 0.6rem; color: #94a3b8;">BASIC (⚪)</div>
                                    <div class="pixel-text font-bold mt-1" style="font-size: 1.2rem; color: #f8fafc;">
                                        @_currentStage.EnemyCounts.Basic
                                    </div>
                                    <div style="font-size: 0.7rem; color: #64748b;">100 PTS</div>
                                </div>
                            </MudItem>
                            <!-- Fast Tank -->
                            <MudItem xs="6" sm="3">
                                <div class="pa-2 text-center" style="background: #11141c; border-radius: 6px; border: 1px solid #334155;">
                                    <div class="pixel-text" style="font-size: 0.6rem; color: #f1c40f;">FAST (🟡)</div>
                                    <div class="pixel-text font-bold mt-1" style="font-size: 1.2rem; color: #f1c40f;">
                                        @_currentStage.EnemyCounts.Fast
                                    </div>
                                    <div style="font-size: 0.7rem; color: #64748b;">200 PTS</div>
                                </div>
                            </MudItem>
                            <!-- Power Tank -->
                            <MudItem xs="6" sm="3">
                                <div class="pa-2 text-center" style="background: #11141c; border-radius: 6px; border: 1px solid #334155;">
                                    <div class="pixel-text" style="font-size: 0.6rem; color: #e74c3c;">POWER (🔴)</div>
                                    <div class="pixel-text font-bold mt-1" style="font-size: 1.2rem; color: #e74c3c;">
                                        @_currentStage.EnemyCounts.Power
                                    </div>
                                    <div style="font-size: 0.7rem; color: #64748b;">300 PTS</div>
                                </div>
                            </MudItem>
                            <!-- Armor Tank -->
                            <MudItem xs="6" sm="3">
                                <div class="pa-2 text-center" style="background: #11141c; border-radius: 6px; border: 1px solid #334155;">
                                    <div class="pixel-text" style="font-size: 0.6rem; color: #2ecc71;">ARMOR (🛡️)</div>
                                    <div class="pixel-text font-bold mt-1" style="font-size: 1.2rem; color: #2ecc71;">
                                        @_currentStage.EnemyCounts.Armor
                                    </div>
                                    <div style="font-size: 0.7rem; color: #64748b;">400 PTS</div>
                                </div>
                            </MudItem>
                        </MudGrid>

                        <!-- Total banner -->
                        <div class="d-flex justify-space-between align-center pa-2 px-3 mb-4" style="background: #1e293b; border-radius: 6px;">
                            <span class="pixel-text" style="font-size: 0.7rem; color: #cbd5e1;">TOTAL ENEMIES DEPLOYED</span>
                            <span class="pixel-text font-bold" style="font-size: 0.9rem; color: #f1c40f;">@_currentStage.EnemyCounts.Total / 20</span>
                        </div>

                        <!-- Sequential Spawn Queue -->
                        <div class="mb-4">
                            <div class="pixel-text mb-2" style="font-size: 0.65rem; color: #94a3b8;">
                                SEQUENTIAL SPAWN QUEUE (1 → 20)
                            </div>
                            <div class="d-flex flex-wrap gap-1 pa-2" style="background: #090a0f; border-radius: 6px; border: 1px solid #232938;">
                                @for (int i = 0; i < _currentStage.SpawnOrder.Count; i++)
                                {
                                    var type = _currentStage.SpawnOrder[i];
                                    var (label, color) = GetEnemyBadge(type);
                                    <div class="d-flex flex-column align-center" style="width: 28px; padding: 2px; background: #161a23; border-radius: 3px; border: 1px solid @color;">
                                        <span style="font-size: 0.55rem; color: #64748b;">@(i + 1)</span>
                                        <span class="pixel-text" style="font-size: 0.65rem; color: @color; font-weight: bold;">@label</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Terrain breakdown -->
                        <div class="mb-2">
                            <div class="pixel-text mb-2" style="font-size: 0.65rem; color: #94a3b8;">
                                TERRAIN DISTRIBUTION
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error">
                                    BRICK: @_brickCount
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                    STEEL: @_steelCount
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                    WATER: @_waterCount
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                                    TREES: @_treesCount
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                    ICE: @_iceCount
                                </MudChip>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-center pa-8">
                            <MudProgressCircular Color="Color.Warning" Indeterminate="true" />
                        </div>
                    }
                </MudCard>

                <!-- Stage JSON Info Card -->
                <MudCard Elevation="2" Class="pa-4 retro-card">
                    <div class="d-flex align-center justify-space-between">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Info" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2" Class="pixel-text" Style="color: #94a3b8; font-size: 0.75rem;">
                                FILE: stage_@(_currentStageNum.ToString("D2")).json
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" 
                                   StartIcon="@Icons.Material.Filled.Visibility" OnClick="ToggleJsonView">
                            @(_showJson ? "HIDE JSON" : "VIEW JSON")
                        </MudButton>
                    </div>

                    @if (_showJson && _currentStage != null)
                    {
                        <pre class="mt-3 pa-3" style="background: #090a0f; border-radius: 6px; max-height: 220px; overflow-y: auto; font-family: monospace; font-size: 0.7rem; color: #a5f3fc; border: 1px solid #232938;">
@System.Text.Json.JsonSerializer.Serialize(_currentStage, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })
                        </pre>
                    }
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <!-- TAB 2: CHR TILE & SPRITE CATALOG -->
    <MudTabPanel Text="CHR-ROM TILE CATALOG" Icon="@Icons.Material.Filled.GridOn">
        <MudCard Elevation="2" Class="pa-4 retro-card">
            <div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-4">
                <div>
                    <MudText Typo="Typo.h6" Class="pixel-text" Style="color: #f1c40f; font-size: 0.95rem;">
                        512 CHR TILES (chr_all.png)
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: #94a3b8;">
                        Tiles 0–255: Background (Terrain, Eagle, HUD) • Tiles 256–511: Sprites (Tanks, Explosions, Power-ups)
                    </MudText>
                </div>

                <!-- Palette Selector -->
                <div class="d-flex align-center gap-2">
                    <span class="pixel-text" style="font-size: 0.7rem; color: #94a3b8;">PALETTE:</span>
                    <MudSelect T="int" Value="_selectedPalIdx" ValueChanged="OnPaletteChanged" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 170px;">
                        <MudSelectItem Value="0">BG0 (Brick)</MudSelectItem>
                        <MudSelectItem Value="1">BG1 (Water)</MudSelectItem>
                        <MudSelectItem Value="2">BG2 (Trees)</MudSelectItem>
                        <MudSelectItem Value="3">BG3 (Steel/Ice)</MudSelectItem>
                        <MudSelectItem Value="4">SP0 (P1 Yellow)</MudSelectItem>
                        <MudSelectItem Value="5">SP1 (P2 Green)</MudSelectItem>
                        <MudSelectItem Value="6">SP2 (Enemy/Specials)</MudSelectItem>
                        <MudSelectItem Value="7">SP3 (Special Eagle)</MudSelectItem>
                    </MudSelect>
                </div>
            </div>

            <!-- CHR Sheet Canvas -->
            <div class="d-flex justify-center pa-4 mb-6" style="background: #090a0f; border-radius: 8px; border: 2px solid #232938; overflow-x: auto;">
                <canvas id="chrCanvas" style="image-rendering: pixelated;"></canvas>
            </div>

            <!-- Interactive Tank Metasprite Inspector -->
            <MudText Typo="Typo.subtitle1" Class="pixel-text font-bold mb-3" Style="color: #f1c40f; font-size: 0.85rem;">
                TANK METASPRITE (2x2 CHR) LIVE PREVIEW
            </MudText>
            
            <MudGrid Spacing="3">
                @foreach (var tank in _previewTanks)
                {
                    <MudItem xs="12" sm="6" md="4" lg="2">
                        <div class="pa-3 text-center" style="background: #11141c; border-radius: 6px; border: 1px solid #334155;">
                            <div class="pixel-text mb-2" style="font-size: 0.65rem; color: #f1c40f;">@tank.Name</div>
                            <div class="d-flex justify-center my-2">
                                <canvas id="@($"tankCanvas_{tank.Id}")" style="image-rendering: pixelated;"></canvas>
                            </div>
                            <!-- Direction Selector -->
                            <div class="d-flex justify-center gap-1 mt-2">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" 
                                               Color="@(tank.Dir == 0 ? Color.Warning : Color.Default)"
                                               OnClick="@(() => SetTankDir(tank, 0))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" 
                                               Color="@(tank.Dir == 1 ? Color.Warning : Color.Default)"
                                               OnClick="@(() => SetTankDir(tank, 1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" 
                                               Color="@(tank.Dir == 2 ? Color.Warning : Color.Default)"
                                               OnClick="@(() => SetTankDir(tank, 2))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" 
                                               Color="@(tank.Dir == 3 ? Color.Warning : Color.Default)"
                                               OnClick="@(() => SetTankDir(tank, 3))" />
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </MudCard>
    </MudTabPanel>

    <!-- TAB 3: POWER-UPS & SPECIALS INSPECTOR -->
    <MudTabPanel Text="POWER-UPS &amp; SPECIALS" Icon="@Icons.Material.Filled.Stars">
        <MudCard Elevation="2" Class="pa-4 retro-card">
            <div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-4">
                <div>
                    <MudText Typo="Typo.h6" Class="pixel-text" Style="color: #f1c40f; font-size: 0.95rem;">
                        SPECIAL ITEMS &amp; POWER-UPS (ROM $E330 / $E3E2 / $EB17)
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: #94a3b8;">
                        Authentic 16×16 px metasprites extracted from CHR-ROM PT1 ($80–$9B, $C8–$CF) with NES Palettes
                    </MudText>
                </div>
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.65rem;">
                    6 POWER-UPS + 4 SPECIALS
                </MudChip>
            </div>

            <!-- Power-Ups Grid -->
            <MudText Typo="Typo.subtitle1" Class="pixel-text font-bold mb-3" Style="color: #f1c40f; font-size: 0.85rem;">
                DROPPABLE POWER-UPS (FLASHING TANKS)
            </MudText>

            <MudGrid Spacing="3" Class="mb-6">
                @foreach (var item in _powerUpItems)
                {
                    <MudItem xs="12" sm="6" md="4" lg="2">
                        <div class="pa-3 text-center d-flex flex-column justify-space-between" style="background: #11141c; border-radius: 6px; border: 1px solid #334155; height: 100%;">
                            <div>
                                <div class="pixel-text mb-2" style="font-size: 0.65rem; color: #f1c40f;">@item.Name</div>
                                <div class="d-flex justify-center my-2">
                                    <canvas id="@($"itemCanvas_{item.Id}")" style="image-rendering: pixelated;"></canvas>
                                </div>
                                <div style="font-size: 0.75rem; color: #cbd5e1; min-height: 48px;" class="px-1">
                                    @item.Description
                                </div>
                            </div>
                            <div class="mt-3">
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.VolumeUp"
                                           OnClick="PlayBonusSfx" Style="font-size: 0.65rem;" FullWidth="true">
                                    SFX +500 PTS
                                </MudButton>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>

            <!-- Specials & HQ State Grid -->
            <MudText Typo="Typo.subtitle1" Class="pixel-text font-bold mb-3" Style="color: #f1c40f; font-size: 0.85rem;">
                HEADQUARTERS &amp; SHIELD STATUS
            </MudText>

            <MudGrid Spacing="3">
                @foreach (var special in _specialItems)
                {
                    <MudItem xs="12" sm="6" md="3">
                        <div class="pa-3 text-center d-flex flex-column justify-space-between" style="background: #11141c; border-radius: 6px; border: 1px solid #334155; height: 100%;">
                            <div>
                                <div class="pixel-text mb-2" style="font-size: 0.65rem; color: #f1c40f;">@special.Name</div>
                                <div class="d-flex justify-center my-2">
                                    <canvas id="@($"itemCanvas_{special.Id}")" style="image-rendering: pixelated;"></canvas>
                                </div>
                                <div style="font-size: 0.75rem; color: #cbd5e1; min-height: 40px;" class="px-1">
                                    @special.Description
                                </div>
                            </div>
                            <div class="mt-2">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@special.BadgeColor" Style="font-size: 0.65rem;">
                                    @special.Badge
                                </MudChip>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </MudCard>
    </MudTabPanel>
</MudTabs>

@code {
    private int _currentStageNum = 1;
    private StageModel? _currentStage;
    private bool _showGrid = false;
    private bool _showSpawns = true;
    private bool _showCoords = false;
    private bool _showJson = false;

    private int _brickCount = 0;
    private int _steelCount = 0;
    private int _waterCount = 0;
    private int _treesCount = 0;
    private int _iceCount = 0;

    private int _selectedPalIdx = 0;

    private class TankPreviewModel
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public int EnemyType { get; set; }
        public int Dir { get; set; } = 0;
    }

    private List<TankPreviewModel> _previewTanks = new()
    {
        new() { Id = "p1", Name = "PLAYER 1", EnemyType = -1, Dir = 0 },
        new() { Id = "p2", Name = "PLAYER 2", EnemyType = -2, Dir = 0 },
        new() { Id = "t0", Name = "BASIC TANK", EnemyType = 0, Dir = 2 },
        new() { Id = "t1", Name = "FAST TANK", EnemyType = 1, Dir = 2 },
        new() { Id = "t2", Name = "POWER TANK", EnemyType = 2, Dir = 2 },
        new() { Id = "t3", Name = "ARMOR TANK", EnemyType = 3, Dir = 2 },
    };

    private class ItemDisplayModel
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int[] Tiles { get; set; } = Array.Empty<int>();
        public int PalIdx { get; set; } = 6;
        public bool Pt1 { get; set; } = false;
        public string Badge { get; set; } = string.Empty;
        public Color BadgeColor { get; set; } = Color.Default;
    }

    private List<ItemDisplayModel> _powerUpItems = new()
    {
        new() { Id = "helmet", Name = "HELMET", Description = "ให้เกราะ Forcefield อมตะชั่วคราวแก่รถถัง (192 frames)", Tiles = new[] { 0x80, 0x82, 0x81, 0x83 }, PalIdx = 6, Pt1 = false },
        new() { Id = "timer", Name = "TIMER", Description = "หยุดการเคลื่อนไหวและการยิงของศัตรูทั้งสนามชั่วคราว", Tiles = new[] { 0x84, 0x86, 0x85, 0x87 }, PalIdx = 6, Pt1 = false },
        new() { Id = "shovel", Name = "SHOVEL", Description = "เปลี่ยนกำแพงรอบฐานอินทรีเป็นเหล็กชั่วคราว (1200 frames)", Tiles = new[] { 0x88, 0x8A, 0x89, 0x8B }, PalIdx = 6, Pt1 = false },
        new() { Id = "star", Name = "STAR", Description = "อัปเกรดพลังยิง: 1★ ยิงเร็ว, 2★ ยิง 2 นัด, 3★ ทำลายเหล็ก", Tiles = new[] { 0x8C, 0x8E, 0x8D, 0x8F }, PalIdx = 6, Pt1 = false },
        new() { Id = "grenade", Name = "GRENADE", Description = "ทำลายรถถังศัตรูทั้งหมดที่อยู่บนสนามทันที (+คะแนนปกติ)", Tiles = new[] { 0x90, 0x92, 0x91, 0x93 }, PalIdx = 6, Pt1 = false },
        new() { Id = "life", Name = "1-UP TANK", Description = "เพิ่มชีวิตสำรองให้กับผู้เล่น 1 ชีวิต (Award Extra Life)", Tiles = new[] { 0x94, 0x96, 0x95, 0x97 }, PalIdx = 6, Pt1 = false },
    };

    private List<ItemDisplayModel> _specialItems = new()
    {
        new() { Id = "eagle_ok", Name = "EAGLE INTACT", Description = "ฐานบัญชาการปกติ (Phoenix HQ Alive)", Tiles = new[] { 0xC8, 0xCA, 0xC9, 0xCB }, PalIdx = 0, Pt1 = false, Badge = "ACTIVE HQ", BadgeColor = Color.Success },
        new() { Id = "eagle_dead", Name = "EAGLE DESTROYED", Description = "ฐานอินทรีถูกยิงทำลาย (Trigger Game Over)", Tiles = new[] { 0xCC, 0xCE, 0xCD, 0xCF }, PalIdx = 0, Pt1 = false, Badge = "GAME OVER", BadgeColor = Color.Error },
        new() { Id = "shield_anim", Name = "FORCE SHIELD", Description = "วงแสงบาเรียป้องกันตัวผู้เล่น (Player Shield)", Tiles = new[] { 0x28, 0x2A, 0x29, 0x2B }, PalIdx = 6, Pt1 = false, Badge = "DEFENSE", BadgeColor = Color.Info },
        new() { Id = "score_500", Name = "500 PTS FLASH", Description = "ป้ายคะแนนลอยเมื่อเก็บไอเทม (+500 Score)", Tiles = new[] { 0x3A, 0x3C, 0x3B, 0x3D }, PalIdx = 6, Pt1 = false, Badge = "+500 PTS", BadgeColor = Color.Warning },
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadStage(_currentStageNum);
    }

    private bool _isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isInitialized = true;
            await Task.Delay(200);
            await RenderCurrentStageCanvas();
        }
    }

    private async Task OnActiveTabChanged(int tabIndex)
    {
        await Task.Delay(100);
        if (tabIndex == 0)
        {
            await RenderCurrentStageCanvas();
        }
        else if (tabIndex == 1)
        {
            await RenderCHRSheetCanvas();
            await RenderAllTankPreviews();
        }
        else if (tabIndex == 2)
        {
            await RenderAllItems();
        }
    }

    private async Task RenderAllItems()
    {
        foreach (var item in _powerUpItems)
        {
            try
            {
                await JS.InvokeVoidAsync("StageRenderer.renderMetaspriteCustom", $"itemCanvas_{item.Id}", item.Tiles, item.PalIdx, item.Pt1, 4);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Render item {item.Id} error: {ex.Message}");
            }
        }

        foreach (var sp in _specialItems)
        {
            try
            {
                await JS.InvokeVoidAsync("StageRenderer.renderMetaspriteCustom", $"itemCanvas_{sp.Id}", sp.Tiles, sp.PalIdx, sp.Pt1, 4);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Render special {sp.Id} error: {ex.Message}");
            }
        }
    }

    private async Task PlayBonusSfx()
    {
        try
        {
            await JS.InvokeVoidAsync("nesSynth.playBonus");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Bonus sound error: {ex.Message}");
        }
    }

    private async Task LoadStage(int stageNum)
    {
        _currentStageNum = stageNum;
        _currentStage = await StageService.GetStageAsync(stageNum);
        CalculateTerrainStats();
        if (_isInitialized)
        {
            await Task.Delay(50);
            await RenderCurrentStageCanvas();
        }
    }

    private void CalculateTerrainStats()
    {
        if (_currentStage == null) return;
        _brickCount = 0; _steelCount = 0; _waterCount = 0; _treesCount = 0; _iceCount = 0;

        foreach (var row in _currentStage.Grid)
        {
            foreach (var t in row)
            {
                if (t >= 0 && t <= 4) _brickCount++;
                else if (t >= 5 && t <= 9) _steelCount++;
                else if (t == 10) _waterCount++;
                else if (t == 11) _treesCount++;
                else if (t == 12) _iceCount++;
            }
        }
    }

    private async Task NextStage()
    {
        if (_currentStageNum < 35)
        {
            _currentStageNum++;
            await LoadStage(_currentStageNum);
            await RenderCurrentStageCanvas();
        }
    }

    private async Task PrevStage()
    {
        if (_currentStageNum > 1)
        {
            _currentStageNum--;
            await LoadStage(_currentStageNum);
            await RenderCurrentStageCanvas();
        }
    }

    private async Task OnSliderChanged(int value)
    {
        if (value != _currentStageNum)
        {
            _currentStageNum = value;
            await LoadStage(_currentStageNum);
            await RenderCurrentStageCanvas();
        }
    }

    private async Task OnGridOptionChanged(bool val)
    {
        _showGrid = val;
        await RenderCurrentStageCanvas();
    }

    private async Task OnSpawnsOptionChanged(bool val)
    {
        _showSpawns = val;
        await RenderCurrentStageCanvas();
    }

    private async Task OnCoordsOptionChanged(bool val)
    {
        _showCoords = val;
        await RenderCurrentStageCanvas();
    }

    private async Task RenderCurrentStageCanvas()
    {
        if (_currentStage == null) return;
        try
        {
            await JS.InvokeVoidAsync("StageRenderer.renderStage", "stageCanvas", _currentStage.Grid, new
            {
                showGrid = _showGrid,
                showSpawns = _showSpawns,
                showCoords = _showCoords,
                scale = 2
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Stage render error: {ex.Message}");
        }
    }

    private async Task RenderCHRSheetCanvas()
    {
        try
        {
            await JS.InvokeVoidAsync("StageRenderer.renderCHRSheet", "chrCanvas", _selectedPalIdx, 2);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"CHR render error: {ex.Message}");
        }
    }

    private async Task OnPaletteChanged(int newPal)
    {
        _selectedPalIdx = newPal;
        await RenderCHRSheetCanvas();
    }

    private async Task SetTankDir(TankPreviewModel tank, int dir)
    {
        tank.Dir = dir;
        await RenderTankPreview(tank);
    }

    private async Task RenderTankPreview(TankPreviewModel tank)
    {
        try
        {
            await JS.InvokeVoidAsync("StageRenderer.renderTankPreview", $"tankCanvas_{tank.Id}", tank.EnemyType, tank.Dir, 0, 3);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Tank preview error: {ex.Message}");
        }
    }

    private async Task RenderAllTankPreviews()
    {
        foreach (var tank in _previewTanks)
        {
            await RenderTankPreview(tank);
        }
    }

    private void ToggleJsonView()
    {
        _showJson = !_showJson;
    }

    private (string Label, string Color) GetEnemyBadge(int type)
    {
        return type switch
        {
            0 => ("B", "#f8fafc"),
            1 => ("F", "#f1c40f"),
            2 => ("P", "#e74c3c"),
            3 => ("A", "#2ecc71"),
            _ => ("?", "#64748b")
        };
    }
}
