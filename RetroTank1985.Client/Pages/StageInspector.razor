@page "/stage-inspector"
@namespace RetroTank1985.Client.Pages

<PageTitle>RetroTank 1985 | Stage &amp; CHR Inspector</PageTitle>

<div class="mb-6">
    <div class="d-flex align-center justify-space-between flex-wrap gap-4">
        <div>
            <MudText Typo="Typo.h4" Class="pixel-text font-bold" Style="color: #f1c40f; text-shadow: 0 0 12px rgba(241, 196, 15, 0.4);">
                STAGE &amp; ROM INSPECTOR
            </MudText>
            <MudText Typo="Typo.subtitle1" Style="color: #94a3b8; font-family: 'Rajdhani', sans-serif; letter-spacing: 1px;">
                REVERSE-ENGINEERED 35 FAMICOM STAGES ($F07A) &amp; CHR-ROM TILEMAP ($DB79)
            </MudText>
        </div>
        <div class="d-flex align-center gap-3">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.7rem;">
                35 STAGES EXTRACTED
            </MudChip>
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.7rem;">
                NES PALETTE $D44A
            </MudChip>
        </div>
    </div>
</div>

<MudTabs Elevation="3" Rounded="true" ApplyEffectsToContainer="true" Class="retro-card"
         ActivePanelIndexChanged="OnActiveTabChanged">
    <!-- TAB 1: 35 STAGES VIEWER -->
    <MudTabPanel Text="STAGE ARENA VIEWER" Icon="@Icons.Material.Filled.Map">
        <StageArenaTab @ref="_stageArenaRef"
                       CurrentStage="_currentStage" 
                       CurrentStageNum="_currentStageNum" 
                       OnStageChanged="LoadStage" />
    </MudTabPanel>

    <!-- TAB 2: CHR TILE & SPRITE CATALOG -->
    <MudTabPanel Text="CHR-ROM TILE CATALOG" Icon="@Icons.Material.Filled.GridOn">
        <ChrTileCatalogTab @ref="_chrCatalogRef" />
    </MudTabPanel>

    <!-- TAB 3: POWER-UPS & SPECIALS INSPECTOR -->
    <MudTabPanel Text="POWER-UPS &amp; SPECIALS" Icon="@Icons.Material.Filled.Stars">
        <PowerUpsSpecialsTab @ref="_powerUpsRef" />
    </MudTabPanel>

    <!-- TAB 4: BOSS MECH WORKSHOP -->
    <MudTabPanel Text="👑 BOSS MECH STUDIO" Icon="@Icons.Material.Filled.Shield">
        <BossMechStudioTab @ref="_bossStudioRef" />
    </MudTabPanel>
</MudTabs>



