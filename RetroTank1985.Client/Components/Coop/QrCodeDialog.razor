@using MudBlazor
@using RetroTank1985.Shared.Services

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.QrCode2" Color="Color.Warning" />
            <span class="pixel-text" style="color: #f1c40f; font-size: 0.95rem;">SCAN TO JOIN CO-OP</span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column align-center justify-center py-4">
            <div class="pa-3 mb-3" style="background: #ffffff; border-radius: 8px; display: inline-block;">
                <!-- Local In-App QR Code Generator (No External API) -->
                @if (!string.IsNullOrEmpty(QrDataUri))
                {
                    <img src="@QrDataUri" alt="Room QR Code" style="width: 220px; height: 220px; display: block;" />
                }
                else
                {
                    <MudProgressCircular Color="Color.Warning" Indeterminate="true" />
                }
            </div>
            <div class="pixel-text font-bold mb-1" style="font-size: 1.2rem; color: #f1c40f; letter-spacing: 2px;">
                @RoomCode
            </div>
            <span class="text-caption text-center" style="color: #94a3b8;">
                สแกนด้วยกล้องมือถือเพื่อเข้าเล่นร่วมกับผู้เล่น P1 ทันที (Local In-Memory Engine)
            </span>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="Close">
            CLOSE
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string RoomCode { get; set; } = string.Empty;

    [Parameter]
    public string InviteUrl { get; set; } = string.Empty;

    private string QrDataUri => string.IsNullOrWhiteSpace(InviteUrl) 
        ? string.Empty 
        : QrCodeGeneratorService.GenerateSvgDataUri(InviteUrl, pixelsPerModule: 8, darkColorHex: "#0c0d12", lightColorHex: "#ffffff");

    private void Close() => MudDialog.Close();
}

