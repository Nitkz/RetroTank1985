<div class="d-flex align-center gap-2 flex-wrap">
    <MudButton Variant="Variant.Outlined" 
               Color="Color.Warning" 
               Size="Size.Small" 
               OnClick="OnPrevClicked" 
               Disabled="@(SelectedStage <= 1)">
        &lt; PREV
    </MudButton>

    <MudSelect T="int" 
               Value="@SelectedStage" 
               ValueChanged="OnStageSelected" 
               Dense="true" 
               Margin="Margin.Dense" 
               Style="min-width: 140px; font-family: var(--retro-font); font-size: 0.8rem;">
        @for (int s = 1; s <= 35; s++)
        {
            var stageNum = s;
            <MudSelectItem Value="@stageNum">STAGE @stageNum.ToString("D2")</MudSelectItem>
        }
    </MudSelect>

    <MudButton Variant="Variant.Outlined" 
               Color="Color.Warning" 
               Size="Size.Small" 
               OnClick="OnNextClicked" 
               Disabled="@(SelectedStage >= 35)">
        NEXT &gt;
    </MudButton>

    <MudButton Variant="Variant.Filled" 
               Color="Color.Error" 
               Size="Size.Small" 
               OnClick="OnResetClicked" 
               StartIcon="@Icons.Material.Filled.Refresh">
        SPAWN P1
    </MudButton>

    <MudButton Variant="Variant.Filled" 
               Color="@(IsMuted ? Color.Default : Color.Success)" 
               Size="Size.Small" 
               OnClick="OnMuteToggled" 
               StartIcon="@(IsMuted ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)">
        @(IsMuted ? "MUTED" : "SOUND ON")
    </MudButton>
</div>

@code {
    [Parameter] public int SelectedStage { get; set; } = 1;
    [Parameter] public bool IsMuted { get; set; }
    [Parameter] public EventCallback<int> StageChanged { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback OnToggleMute { get; set; }

    private async Task OnStageSelected(int stageNum) => await StageChanged.InvokeAsync(stageNum);
    private async Task OnPrevClicked() => await StageChanged.InvokeAsync(SelectedStage - 1);
    private async Task OnNextClicked() => await StageChanged.InvokeAsync(SelectedStage + 1);
    private async Task OnResetClicked() => await OnReset.InvokeAsync();
    private async Task OnMuteToggled() => await OnToggleMute.InvokeAsync();
}
