<MudCard Elevation="4" Class="retro-card pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="pixel-text mb-3" Style="color: #f1c40f; font-size: 0.9rem;">
        MISSION BRIEFING &bull; STAGE @StageNumber.ToString("D2")
    </MudText>

    @if (Stage != null)
    {
        <div class="d-flex justify-space-between align-center mb-3">
            <MudText Typo="Typo.body2" Style="color: #cbd5e1;">Enemy Battalion:</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.65rem;">
                20 TANKS
            </MudChip>
        </div>

        <MudGrid Spacing="1" Class="mb-3">
            <MudItem xs="6" sm="3">
                <div class="pa-2 text-center" style="background: #0f172a; border-radius: 4px; border: 1px solid #1e293b;">
                    <div class="pixel-text" style="font-size: 0.65rem; color: #94a3b8;">BASIC</div>
                    <div class="pixel-text" style="font-size: 1rem; color: #f1c40f;">@Stage.EnemyCounts.Basic</div>
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="pa-2 text-center" style="background: #0f172a; border-radius: 4px; border: 1px solid #1e293b;">
                    <div class="pixel-text" style="font-size: 0.65rem; color: #38bdf8;">FAST</div>
                    <div class="pixel-text" style="font-size: 1rem; color: #38bdf8;">@Stage.EnemyCounts.Fast</div>
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="pa-2 text-center" style="background: #0f172a; border-radius: 4px; border: 1px solid #1e293b;">
                    <div class="pixel-text" style="font-size: 0.65rem; color: #94a3b8;">POWER</div>
                    <div class="pixel-text" style="font-size: 1rem; color: #fb923c;">@Stage.EnemyCounts.Power</div>
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="pa-2 text-center" style="background: #0f172a; border-radius: 4px; border: 1px solid #1e293b;">
                    <div class="pixel-text" style="font-size: 0.65rem; color: #94a3b8;">ARMOR</div>
                    <div class="pixel-text" style="font-size: 1rem; color: #4ade80;">@Stage.EnemyCounts.Armor</div>
                </div>
            </MudItem>
        </MudGrid>
    }

    <MudDivider Class="my-3" Style="border-color: #2c3245;" />

    <MudText Typo="Typo.subtitle2" Class="pixel-text mb-2" Style="color: #94a3b8; font-size: 0.75rem;">
        KEYBOARD &amp; CONTROLS
    </MudText>
    <div class="d-flex flex-column gap-2" style="font-size: 0.82rem; color: #94a3b8;">
        <!-- Player 1 (Yellow Tank) -->
        <div class="pa-2" style="background: rgba(241, 196, 15, 0.06); border-left: 3px solid #f1c40f; border-radius: 4px;">
            <div class="d-flex justify-space-between align-center mb-1">
                <span class="pixel-text" style="color: #f1c40f; font-size: 0.65rem; font-weight: bold;">PLAYER 1 (YELLOW)</span>
            </div>
            <div class="d-flex justify-space-between" style="font-size: 0.75rem;">
                <span>Move: <strong class="pixel-text" style="color: #f1c40f; font-size: 0.65rem;">W, A, S, D</strong></span>
                <span>Fire: <strong class="pixel-text" style="color: #ef4444; font-size: 0.65rem;">SPACEBAR / J</strong></span>
            </div>
        </div>

        <!-- Player 2 (Green Tank) -->
        <div class="pa-2" style="background: rgba(46, 204, 113, 0.06); border-left: 3px solid #2ecc71; border-radius: 4px;">
            <div class="d-flex justify-space-between align-center mb-1">
                <span class="pixel-text" style="color: #2ecc71; font-size: 0.65rem; font-weight: bold;">PLAYER 2 (GREEN CO-OP)</span>
            </div>
            <div class="d-flex justify-space-between" style="font-size: 0.75rem;">
                <span>Move: <strong class="pixel-text" style="color: #2ecc71; font-size: 0.65rem;">ARROWS</strong></span>
                <span>Fire: <strong class="pixel-text" style="color: #ef4444; font-size: 0.65rem;">ENTER / NUM 0 / K</strong></span>
            </div>
        </div>

        <!-- System Controls -->
        <div class="d-flex justify-space-between pt-1" style="font-size: 0.75rem; border-top: 1px solid #1e293b;">
            <span>Pause: <strong class="pixel-text" style="color: #38bdf8; font-size: 0.65rem;">P / ESC</strong></span>
            <span>Restart: <strong class="pixel-text" style="color: #fb923c; font-size: 0.65rem;">R</strong></span>
        </div>
    </div>
</MudCard>

@code {
    [Parameter] public int StageNumber { get; set; } = 1;
    [Parameter] public StageModel? Stage { get; set; }
}
