<div class="d-flex justify-space-between align-center px-3 py-2 w-100 flex-wrap gap-2" 
     style="background: #161a23; border: 1px solid #2c3245; border-radius: 6px; box-sizing: border-box;">
    <div class="d-flex align-center gap-2 flex-wrap">
        <span class="pixel-text" style="font-size: 0.75rem; color: #f1c40f;">FPS: @Telemetry.Fps</span>
        <span style="color: #475569;">|</span>
        <span class="pixel-text" style="font-size: 0.7rem; color: #f1c40f;">1P: (@Telemetry.X, @Telemetry.Y) L:@Telemetry.Lives</span>
        @if (Telemetry.IsTwoPlayer)
        {
            <span style="color: #475569;">|</span>
            <span class="pixel-text" style="font-size: 0.7rem; color: #2ecc71;">2P: (@Telemetry.P2X, @Telemetry.P2Y) L:@Telemetry.P2Lives</span>
        }
    </div>
    <div class="d-flex align-center gap-2 flex-wrap">
        <span class="pixel-text" style="font-size: 0.7rem; color: #ef4444;">ENEMIES: @Telemetry.EnemiesLeft (ACT: @Telemetry.EnemiesActive)</span>
        <span style="color: #475569;">|</span>
        @if (Telemetry.Shield)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.55rem; height: 18px;">
                SHIELD
            </MudChip>
        }
        else
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.55rem; height: 18px;">
                ACTIVE
            </MudChip>
        }
    </div>
</div>

@code {
    [Parameter] public TelemetryData Telemetry { get; set; } = new();
}
