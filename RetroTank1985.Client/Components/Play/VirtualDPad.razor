<MudCard Elevation="4" Class="retro-card pa-4">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h6" Class="pixel-text" Style="color: #f1c40f; font-size: 0.9rem;">
            TOUCH / MOBILE D-PAD
        </MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="pixel-text" Style="font-size: 0.55rem;">
            0ms DIRECT
        </MudChip>
    </div>

    <div class="d-flex justify-space-around align-center py-2">
        <!-- Virtual D-Pad -->
        <div class="dpad-container">
            <div></div>
            <button class="dpad-btn" 
                    ontouchstart="window.GameBridge && window.GameBridge.setVirtualInput('up', true); event.preventDefault();" 
                    ontouchend="window.GameBridge && window.GameBridge.setVirtualInput('up', false); event.preventDefault();"
                    ontouchcancel="window.GameBridge && window.GameBridge.setVirtualInput('up', false);"
                    onmousedown="window.GameBridge && window.GameBridge.setVirtualInput('up', true);" 
                    onmouseup="window.GameBridge && window.GameBridge.setVirtualInput('up', false);"
                    onmouseleave="window.GameBridge && window.GameBridge.setVirtualInput('up', false);">
                ▲
            </button>
            <div></div>

            <button class="dpad-btn" 
                    ontouchstart="window.GameBridge && window.GameBridge.setVirtualInput('left', true); event.preventDefault();" 
                    ontouchend="window.GameBridge && window.GameBridge.setVirtualInput('left', false); event.preventDefault();"
                    ontouchcancel="window.GameBridge && window.GameBridge.setVirtualInput('left', false);"
                    onmousedown="window.GameBridge && window.GameBridge.setVirtualInput('left', true);" 
                    onmouseup="window.GameBridge && window.GameBridge.setVirtualInput('left', false);"
                    onmouseleave="window.GameBridge && window.GameBridge.setVirtualInput('left', false);">
                ◀
            </button>
            <div style="display:flex;align-items:center;justify-content:center;">
                <span style="width:12px;height:12px;background:#334155;border-radius:50%;"></span>
            </div>
            <button class="dpad-btn" 
                    ontouchstart="window.GameBridge && window.GameBridge.setVirtualInput('right', true); event.preventDefault();" 
                    ontouchend="window.GameBridge && window.GameBridge.setVirtualInput('right', false); event.preventDefault();"
                    ontouchcancel="window.GameBridge && window.GameBridge.setVirtualInput('right', false);"
                    onmousedown="window.GameBridge && window.GameBridge.setVirtualInput('right', true);" 
                    onmouseup="window.GameBridge && window.GameBridge.setVirtualInput('right', false);"
                    onmouseleave="window.GameBridge && window.GameBridge.setVirtualInput('right', false);">
                ▶
            </button>

            <div></div>
            <button class="dpad-btn" 
                    ontouchstart="window.GameBridge && window.GameBridge.setVirtualInput('down', true); event.preventDefault();" 
                    ontouchend="window.GameBridge && window.GameBridge.setVirtualInput('down', false); event.preventDefault();"
                    ontouchcancel="window.GameBridge && window.GameBridge.setVirtualInput('down', false);"
                    onmousedown="window.GameBridge && window.GameBridge.setVirtualInput('down', true);" 
                    onmouseup="window.GameBridge && window.GameBridge.setVirtualInput('down', false);"
                    onmouseleave="window.GameBridge && window.GameBridge.setVirtualInput('down', false);">
                ▼
            </button>
            <div></div>
        </div>

        <!-- Virtual Fire Button -->
        <div class="d-flex flex-column align-center gap-2">
            <button class="fire-btn" 
                    ontouchstart="window.GameBridge && window.GameBridge.setVirtualInput('fire', true); event.preventDefault();"
                    ontouchend="window.GameBridge && window.GameBridge.setVirtualInput('fire', false); event.preventDefault();"
                    ontouchcancel="window.GameBridge && window.GameBridge.setVirtualInput('fire', false);"
                    onmousedown="window.GameBridge && window.GameBridge.setVirtualInput('fire', true);"
                    onmouseup="window.GameBridge && window.GameBridge.setVirtualInput('fire', false);"
                    onmouseleave="window.GameBridge && window.GameBridge.setVirtualInput('fire', false);">
                FIRE
            </button>
            <button class="mud-button-root mud-button mud-button-filled mud-button-filled-dark mud-button-size-small pixel-text" 
                    onclick="window.GameBridge && window.GameBridge.setVirtualInput('pause', true);"
                    style="font-size:0.65rem; padding: 4px 12px; background: #1e293b; color: #f1c40f; border: 1px solid #475569; border-radius: 4px; cursor: pointer;">
                PAUSE
            </button>
        </div>
    </div>
</MudCard>

@code {
    // Zero C# roundtrips: All touch & mouse inputs are routed directly to GameBridge at 0ms latency!
}
