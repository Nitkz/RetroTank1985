@using RetroTank1985.Client.Engine.Models
@using RetroTank1985.Shared.Enums
@using RetroTank1985.Shared.Models

<div class="d-flex align-center justify-space-between flex-wrap gap-2 w-100 mb-3" style="max-width: 800px;">
    <div class="d-flex align-center gap-2">
        <MudIcon Icon="@Icons.Material.Filled.VideogameAsset" Color="@(IsCoopSession ? Color.Secondary : Color.Warning)" Size="Size.Large" />
        <div>
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.h5" Class="pixel-text" Style="@($"color: {(IsCoopSession ? "#38bdf8" : "#f1c40f")}; font-size: 1.2rem; text-shadow: 0 0 12px {(IsCoopSession ? "rgba(56, 189, 248, 0.4)" : "rgba(241, 196, 15, 0.4)")};")">
                    @(IsCoopSession ? "ONLINE CO-OP ARENA" : "ARCADE MODE")
                </MudText>
                @if (IsCoopSession)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.6rem;">
                        @(IsCoopHost ? "P1 (HOST)" : "P2 (GUEST)")
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Outlined" Class="pixel-text" Style="font-size: 0.6rem; border-color: #38bdf8; color: #38bdf8;">
                        ROOM: @RoomCode
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="@GameUiHelper.GetDifficultyColor(Settings.Preset)" Variant="Variant.Filled" Class="pixel-text" Style="font-size: 0.6rem;">
                        @GameUiHelper.GetDifficultyLabel(Settings.Preset)
                    </MudChip>
                }
            </div>
            <span class="pixel-text" style="color: #94a3b8; font-size: 0.65rem;">
                @(IsCoopSession ? "2-PLAYER SIGNALR MULTIPLAYER • REAL-TIME 60HZ SYNC" : "1-PLAYER NES CAMPAIGN • STAGES 1–35")
            </span>
        </div>
    </div>

    <div class="d-flex align-center gap-2 flex-wrap">
        <!-- High Score Badge -->
        <div class="d-flex align-center px-3 py-1" style="background: rgba(0,0,0,0.5); border-radius: 4px; border: 1px solid #f59e0b;">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Size="Size.Small" Class="mr-1" />
            <span class="pixel-text" style="color: #f59e0b; font-size: 0.7rem;">HI: @HighScore</span>
        </div>

        <!-- Current Score Badge -->
        <div class="d-flex align-center px-3 py-1" style="background: rgba(0,0,0,0.5); border-radius: 4px; border: 1px solid #3b82f6;">
            <span class="pixel-text" style="color: #60a5fa; font-size: 0.7rem;">SCORE: @Telemetry.Score</span>
        </div>

        <!-- Player Lives -->
        <div class="d-flex align-center px-3 py-1" style="background: rgba(0,0,0,0.5); border-radius: 4px; border: 1px solid #ef4444;">
            <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Error" Size="Size.Small" Class="mr-1" />
            <span class="pixel-text" style="color: #ef4444; font-size: 0.7rem;">x@Telemetry.Lives</span>
        </div>

        <!-- Player Armor HP (Hearts / Shield Indicator) -->
        @if (Settings.PlayerArmorHp > 1 && !IsCoopSession)
        {
            <div class="d-flex align-center px-3 py-1" style="background: rgba(0,0,0,0.5); border-radius: 4px; border: 1px solid @GameUiHelper.GetHpBorderColor(Telemetry.Hp);">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Style="@($"color: {GameUiHelper.GetHpBorderColor(Telemetry.Hp)};")" Size="Size.Small" Class="mr-1" />
                <span class="pixel-text" style="color: @GameUiHelper.GetHpBorderColor(Telemetry.Hp); font-size: 0.7rem;">
                    HP: @Telemetry.Hp/@Settings.PlayerArmorHp
                </span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsCoopSession { get; set; }
    [Parameter] public bool IsCoopHost { get; set; }
    [Parameter] public string RoomCode { get; set; } = string.Empty;
    [Parameter] public int HighScore { get; set; }
    [Parameter] public TelemetryData Telemetry { get; set; } = new();
    [Parameter] public GameSettings Settings { get; set; } = new();
}
